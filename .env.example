# MongoDB connection string.
# Local development example:
MONGO_URI=mongodb://127.0.0.1:27017/football_db
# Production example:
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/football_db

# Port used by the Express server.
PORT=5000

# Replace this with a long, random secret in every deployed environment.
JWT_SECRET=replace-with-a-long-random-secret

# Sample seeding is disabled. Create your own accounts and venues.
SEED_DEMO_DATA=false

# Temporary database is opt-in locally and is NEVER used in production.
ALLOW_MEMORY_DB=false
